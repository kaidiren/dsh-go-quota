{
  "name": "dsh-go-quota",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness 插件：侧边栏只显示 OpenCode Go 订阅额度（5h / 周 / 月 + 重置时间），零配置、无其他任何功能",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.5",
      "dshReleases": {
        "0.2.0-rc.1": "compatible"
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
